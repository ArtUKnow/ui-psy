DATABASE_URL=postgres:///ui_psy?host=/tmp
# Copy to .env.local and supply your authorization key locally.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional PEM root certificate, appended to the system trust store. TLS is always verified.
GIGACHAT_CA_FILE=
UI_PSY_BACKUP_INTERVAL=60s
UI_PSY_BACKUP_DIR=server-go/backups
# Keep the newest N dumps; 0 keeps everything. 1440 = 24 h at 60s.
UI_PSY_BACKUP_KEEP=0
UI_PSY_LOG_PATH=server-go/logs/server.jsonl
# Enable only behind a trusted reverse proxy that replaces X-Forwarded-Proto.
UI_PSY_TRUST_PROXY=false
